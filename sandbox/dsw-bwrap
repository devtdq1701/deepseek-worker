#!/usr/bin/env bash
# bwrap runner for dsh (`sandbox.runnerCommand`, written by `dsw setup`): dsh calls
#   dsw-bwrap <bwrap profile args...> -- <command...>
# We keep dsh's profile (read-only root, writable workspace, pid namespace) and add,
# after it so these mounts win: credential paths hidden, and an empty network
# namespace for tools. The model API traffic comes from the dsh node process outside
# bwrap, so it is unaffected.
#
# Hidden paths: sandbox/hidden-paths.txt (shipped), plus in the dsw config dir
# hidden-paths.local.txt (yours) and hidden-paths.generated.txt (`dsw setup`, from
# config.toml [sandbox] hide).
#
# Egress (`dsw run --net`): dsw serves a proxy on a unix socket named after the
# workspace (dsw_net.socket_path / dsw_config.runtime_dir). If that socket exists it is
# bound into the sandbox, socat bridges 127.0.0.1:3128 to it, and the proxy env vars
# point there. Tools still have no route out except through that proxy.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
config_dir="${DSW_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dsw}"

profile=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do profile+=("$1"); shift; done
[ "${1:-}" = "--" ] && shift

hide=()
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [ -z "$line" ] && continue
  path="${line/#\~/$HOME}"
  if [ -d "$path" ]; then
    hide+=(--tmpfs "$path")
  elif [ -e "$path" ]; then
    hide+=(--ro-bind /dev/null "$path")
  fi
done < <(cat "$here/hidden-paths.txt" "$config_dir/hidden-paths.local.txt" "$config_dir/hidden-paths.generated.txt" 2>/dev/null)

# The workspace is the first writable bind in dsh's profile.
workspace=""
for ((i = 0; i < ${#profile[@]}; i++)); do
  if [ "${profile[$i]}" = "--bind" ]; then workspace="${profile[$((i + 1))]}"; break; fi
done

trimmed_lines() {  # non-empty, comment-free, ~-expanded lines of the given files
  local line
  cat "$@" 2>/dev/null | while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] && printf '%s\n' "${line/#\~/$HOME}"
  done
}

# Home default-deny: a denylist always misses something (shell history, browser profiles,
# rclone/cloud CLIs...). Mount an empty tmpfs over $HOME, then bring back only dsh's own
# binds (the workspace), read-only toolchains (home-allow.txt) and, for a git worktree, its
# common .git dir.
homejail=()
if [ -d "$HOME" ]; then
  home_real=$(realpath -- "$HOME")
  in_home() { case "$1" in "$home_real" | "$home_real"/*) return 0 ;; esac; return 1; }
  homejail=(--tmpfs "$home_real")
  for ((i = 0; i < ${#profile[@]}; i++)); do
    case "${profile[$i]}" in
      --bind | --ro-bind | --bind-try | --ro-bind-try)
        dst="${profile[$((i + 2))]}"
        if in_home "$(realpath -m -- "$dst")"; then homejail+=("${profile[$i]}" "${profile[$((i + 1))]}" "$dst"); fi ;;
    esac
  done
  while IFS= read -r path; do
    [ -e "$path" ] && homejail+=(--ro-bind "$path" "$path")
  done < <(trimmed_lines "$here/home-allow.txt" "$config_dir/home-allow.local.txt" "$config_dir/home-allow.generated.txt")
  # The worktree's .git pointer lives in the (worker-writable) workspace, so trust it only when
  # the back-pointer in the real gitdir, outside the workspace, names this workspace.
  if [ -n "$workspace" ] && [ -f "$workspace/.git" ] && [ ! -L "$workspace/.git" ]; then
    ws_real=$(realpath -- "$workspace")
    gitdir=$(sed -n '1s/^gitdir: //p' "$workspace/.git")
    if [ -n "$gitdir" ] && [ -d "$gitdir" ]; then
      gitdir_real=$(realpath -- "$gitdir")
      case "$gitdir_real" in "$ws_real" | "$ws_real"/*) gitdir_real="" ;; esac
      back=$(cat "$gitdir_real/gitdir" 2>/dev/null || true)
      if [ -n "$gitdir_real" ] && [ -f "$gitdir_real/commondir" ] \
         && { [ "$back" = "$workspace/.git" ] || [ "$back" = "$ws_real/.git" ]; }; then
        common=$(cd "$gitdir_real" && realpath -- "$(cat commondir)")
        if [ -d "$common/objects" ]; then homejail+=(--ro-bind "$common" "$common"); fi
      fi
    fi
  fi
fi

proxy=()
launch=()
if [ -n "$workspace" ]; then
  digest=$(printf %s "$(realpath -- "$workspace")" | sha256sum | cut -c1-16)
  base="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  [ -d "$base" ] || base="${TMPDIR:-/tmp}/dsw-$(id -u)"
  sock="$base/dsw/$digest.sock"
  if [ -S "$sock" ]; then
    url="http://127.0.0.1:3128"
    proxy=(--bind "$sock" /tmp/dsw-proxy.sock)
    for name in HTTPS_PROXY https_proxy HTTP_PROXY http_proxy npm_config_proxy npm_config_https_proxy; do
      proxy+=(--setenv "$name" "$url")
    done
    proxy+=(--setenv NO_PROXY "localhost,127.0.0.1" --setenv no_proxy "localhost,127.0.0.1")
    launch=(/bin/sh -c 'socat TCP-LISTEN:3128,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/tmp/dsw-proxy.sock >/dev/null 2>&1 & sleep 0.2; exec "$@"' dsw-net)
  fi
fi

# Host unix sockets live under /run (D-Bus, systemd --user, docker.sock, gpg/ssh agents,
# other jobs' proxy sockets); --unshare-net does not isolate filesystem sockets, and they
# would let a tool run commands outside the sandbox. Hide /run (and /var/run -> /run);
# the job's own proxy socket is bound back in at /tmp/dsw-proxy.sock above.
isolate=(--tmpfs /run --new-session --unshare-ipc)

exec bwrap "${profile[@]}" "${homejail[@]}" "${hide[@]}" "${isolate[@]}" --unshare-net "${proxy[@]}" -- "${launch[@]}" "$@"
